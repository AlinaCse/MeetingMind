<!doctype html><html><head><title>Login | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body class="auth-page"><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container auth-card"><div class="card shadow border-0"><div class="card-body p-4 p-md-5"><h1 class="h3">Welcome back</h1><p class="text-muted">Sign in to keep meetings moving forward.</p><form method="POST" action="/login"><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required></div><div class="mb-4"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required></div><button class="btn btn-primary w-100">Login</button></form><p class="mt-3 mb-0 text-center">New here? <a href="/register">Create an account</a></p></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
