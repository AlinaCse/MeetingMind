<!doctype html><html><head><title><%= meeting.title %> | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container py-4"><div class="d-flex justify-content-between align-items-start mb-4"><div><a href="/meetings" class="text-decoration-none">← Meetings</a><h1 class="mt-2"><%= meeting.title %></h1><p class="text-muted"><%= new Date(meeting.date).toLocaleDateString() %></p></div><form method="POST" action="/meetings/<%= meeting._id %>?_method=DELETE" onsubmit="return confirm('Delete this meeting and its action items?')"><button class="btn btn-outline-danger">Delete meeting</button></form></div><details class="card border-0 shadow-sm mb-4"><summary class="card-header bg-white">Raw notes</summary><pre class="card-body notes"><%= meeting.rawNotes %></pre></details><section class="mb-4"><h2 class="h4">Decisions</h2><ul><% if (!meeting.decisions.length) { %><li class="text-muted">No decisions recorded.</li><% } meeting.decisions.forEach((decision) => { %><li><%= decision %></li><% }) %></ul></section><section class="mb-4"><h2 class="h4">Action items</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Task</th><th>Owner</th><th>Deadline</th><th>Status</th><th></th></tr></thead><tbody><% if (!actionItems.length) { %><tr><td colspan="5" class="text-muted">No action items recorded.</td></tr><% } actionItems.forEach((item) => { %><tr><td><%= item.task %></td><td><%= item.owner %></td><td><%= item.deadline ? new Date(item.deadline).toLocaleDateString() : '—' %></td><td><span class="badge text-bg-<%= item.status === 'done' ? 'success' : item.status === 'overdue' ? 'danger' : 'warning' %>"><%= item.status %></span></td><td><% if (item.status === 'pending') { %><form method="POST" action="/actionItems/<%= item._id %>/done?_method=PUT"><button class="btn btn-sm btn-success">Done</button></form><% } %></td></tr><% }) %></tbody></table></div></section><section><h2 class="h4">Unresolved questions</h2><ul><% if (!meeting.unresolved.length) { %><li class="text-muted">No unresolved questions recorded.</li><% } meeting.unresolved.forEach((question) => { %><li><%= question %></li><% }) %></ul><% if (meeting.nextMeeting) { %><p><strong>Next meeting:</strong> <%= new Date(meeting.nextMeeting).toLocaleDateString() %></p><% } %></section></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
