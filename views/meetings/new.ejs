<!doctype html><html><head><title>New Meeting | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container py-4"><div class="d-flex justify-content-between align-items-center"><div><h1>New meeting</h1><p class="text-muted">Paste notes, review the AI extraction, then save.</p></div><a href="/meetings" class="btn btn-outline-secondary">Back</a></div><form id="meeting-form" method="POST" action="/meetings" class="card border-0 shadow-sm mt-3"><div class="card-body p-4"><div class="row g-3"><div class="col-md-8"><label class="form-label">Meeting title</label><input class="form-control" name="title" required></div><div class="col-md-4"><label class="form-label">Date</label><input class="form-control" type="date" name="date" value="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="col-12"><label class="form-label">Meeting notes</label><textarea id="rawNotes" class="form-control" name="rawNotes" rows="10" required placeholder="Paste your meeting notes here..."></textarea></div></div><input id="analysis" type="hidden" name="analysis"><div class="mt-3 d-flex gap-2 align-items-center"><button id="analyse-button" type="button" class="btn btn-outline-primary">Analyse Meeting</button><span id="analyse-loading" class="text-primary d-none"><span class="spinner-border spinner-border-sm"></span> Analysing your notes...</span></div><section id="analysis-results" class="d-none mt-4 border-top pt-4"><h2 class="h4">AI analysis <span class="small text-muted fw-normal">— edit anything before saving</span></h2><div class="mb-3"><h3 class="h6">Decisions</h3><ul id="decisions-list" class="mb-0"></ul></div><div class="mb-3"><h3 class="h6">Action items</h3><div class="table-responsive"><table class="table"><thead><tr><th>Task</th><th>Owner</th><th>Email</th><th>Deadline</th></tr></thead><tbody id="action-items-table"></tbody></table></div></div><div><h3 class="h6">Unresolved questions</h3><ul id="unresolved-list" class="mb-0"></ul></div></section><button class="btn btn-primary mt-4">Save Meeting</button></div></form></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
