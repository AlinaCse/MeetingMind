<!doctype html><html><head><title>Meetings | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Meetings</h1><p class="text-muted mb-0">Your recorded discussions and commitments.</p></div><a href="/meetings/new" class="btn btn-primary">+ New meeting</a></div><div class="row g-3"><% if (!meetings.length) { %><p class="text-muted">No meetings have been saved yet.</p><% } meetings.forEach((meeting) => { %><div class="col-md-6 col-lg-4"><a href="/meetings/<%= meeting._id %>" class="card meeting-card h-100 text-decoration-none shadow-sm"><div class="card-body"><small class="text-muted"><%= new Date(meeting.date).toLocaleDateString() %></small><h2 class="h5 text-dark mt-2"><%= meeting.title %></h2><span class="badge text-bg-light"><%= meeting.actionItems.length %> action item(s)</span></div></a></div><% }) %></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
