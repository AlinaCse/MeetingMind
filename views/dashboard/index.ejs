<!doctype html><html><head><title>Dashboard | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Welcome, <%= sessionUser %></h1><p class="text-muted mb-0">Your meeting follow-through at a glance.</p></div><a href="/meetings/new" class="btn btn-primary">+ New meeting</a></div><% if (overdueCount) { %><div class="alert alert-danger">You have <strong><%= overdueCount %></strong> overdue action item(s).</div><% } %><section class="mb-5"><h2 class="h4 mb-3">Pending action items</h2><div class="card shadow-sm border-0"><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Task</th><th>Owner</th><th>Deadline</th><th></th></tr></thead><tbody><% if (!pendingItems.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No pending items. You’re all caught up.</td></tr><% } pendingItems.forEach((item) => { const days = item.deadline ? Math.ceil((new Date(item.deadline).setHours(0,0,0,0)-Date.now())/86400000) : 99; %><tr class="urgency-<%= days <= 1 ? 'high' : days <= 3 ? 'medium' : 'normal' %>"><td><%= item.task %></td><td><%= item.owner %></td><td><%= item.deadline ? new Date(item.deadline).toLocaleDateString() : 'No deadline' %></td><td><form method="POST" action="/actionItems/<%= item._id %>/done?_method=PUT"><button class="btn btn-sm btn-success">Done</button></form></td></tr><% }) %></tbody></table></div></div></section><section><h2 class="h4 mb-3">Recent meetings</h2><div class="row g-3"><% if (!meetings.length) { %><p class="text-muted">No meetings yet. Add your first notes to get started.</p><% } meetings.forEach((meeting) => { %><div class="col-md-6 col-lg-4"><a class="card h-100 meeting-card text-decoration-none shadow-sm" href="/meetings/<%= meeting._id %>"><div class="card-body"><small class="text-muted"><%= new Date(meeting.date).toLocaleDateString() %></small><h3 class="h5 text-dark mt-2"><%= meeting.title %></h3><span class="text-primary">View details →</span></div></a></div><% }) %></div></section></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
