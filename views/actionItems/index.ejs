<!doctype html><html><head><title>Action Items | MeetingMind</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><%- include('../partials/navbar') %><%- include('../partials/flash') %><main class="container py-4"><h1>Action items</h1><p class="text-muted">Every commitment from your meetings, in one place.</p><div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Task</th><th>Owner</th><th>Deadline</th><th>Status</th><th>Meeting</th><th></th></tr></thead><tbody><% if (!actionItems.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No action items yet.</td></tr><% } actionItems.forEach((item) => { const days = item.deadline ? Math.ceil((new Date(item.deadline).setHours(0,0,0,0)-Date.now())/86400000) : 99; %><tr class="urgency-<%= item.status === 'overdue' || days <= 1 ? 'high' : days <= 3 ? 'medium' : 'normal' %>"><td><%= item.task %></td><td><%= item.owner %></td><td><%= item.deadline ? new Date(item.deadline).toLocaleDateString() : '—' %></td><td><span class="badge text-bg-<%= item.status === 'done' ? 'success' : item.status === 'overdue' ? 'danger' : 'warning' %>"><%= item.status %></span></td><td><% if (item.meetingId) { %><a href="/meetings/<%= item.meetingId._id %>"><%= item.meetingId.title %></a><% } else { %>—<% } %></td><td><% if (item.status === 'pending') { %><form method="POST" action="/actionItems/<%= item._id %>/done?_method=PUT"><button class="btn btn-sm btn-success">Done</button></form><% } %></td></tr><% }) %></tbody></table></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/main.js"></script></body></html>
