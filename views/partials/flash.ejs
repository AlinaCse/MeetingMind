<div class="container mt-3 flash-container"><% if (successMessages && successMessages.length) { successMessages.forEach((message) => { %><div class="alert alert-success alert-dismissible fade show"><%= message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) } %><% if (errorMessages && errorMessages.length) { errorMessages.forEach((message) => { %><div class="alert alert-danger alert-dismissible fade show"><%= message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% }) } %></div>
